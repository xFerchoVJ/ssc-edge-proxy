# Local testing only. On the VPS no .env is needed (defaults below apply).
#
# Ports to publish on your machine (defaults 80 and 8080). The alternate port
# exists for FortiWeb (comercioseguro on :8080); locally both must differ from
# each other and from anything already in use.
EDGE_PORT=8081
EDGE_PORT_ALT=8082
# Where each app's repo lives, so its nginx/maintenance folder can be mounted.
EMPRESAS_DIR=../ssc-empresas-privadas
COMERCIOSEGURO_DIR=../comercio-seguro-ssc-cancun
